NON_SPORADIC_DATA_CACHE := FixedNonSporadicData();;

NonSporadicDataBySimple := function(simple_name)
    local data;;
    data := First(NON_SPORADIC_DATA_CACHE, entry -> entry.simple_name = simple\
_name);;
    if data = fail then Error("Unknown simple group name: ", simple_name);; fi\
;;
    return ShallowCopy(data);;
end;;
